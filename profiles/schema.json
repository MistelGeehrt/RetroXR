{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MistelGeehrt/flatverse/profiles/schema.json",
  "title": "flatverse game profile",
  "description": "Profil VR d'un jeu Unreal Engine pour UEVR + extensions flatverse. Un dossier par jeu, un profile.json par dossier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game", "engine", "status", "anti_cheat", "tested", "uevr"],
  "properties": {
    "schema_version": { "const": 1 },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "executables"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "store_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steam": { "type": "integer" },
            "gog": { "type": "string" },
            "epic": { "type": "string" }
          }
        },
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^\\\\/]+\\.exe$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "game_version": { "type": "string" }
            }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["unreal", "unity"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" }
      }
    },
    "status": {
      "enum": ["perfect", "playable", "needs-work", "broken", "unverified"],
      "description": "unverified = soumis sans test complet (CI accepte, client affiche un avertissement)"
    },
    "anti_cheat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "name": { "enum": ["EAC", "BattlEye", "Vanguard", "Ricochet", "Denuvo", "other"] },
        "offline_mode_safe": { "type": "boolean" }
      }
    },
    "tested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "by", "headset", "runtime"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "by": { "type": "string" },
        "headset": { "type": "string" },
        "runtime": { "enum": ["openxr-meta-link", "openxr-virtual-desktop", "steamvr", "steamvr-steam-link", "other"] },
        "gpu": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "uevr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "rendering_method"],
      "properties": {
        "build": { "type": "string", "description": "ex. nightly-01143 ou 1.05" },
        "rendering_method": { "enum": ["native-stereo", "synchronized-sequential", "afr"] },
        "cvars": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "config_ini": { "type": "string", "description": "chemin relatif vers un config.txt UEVR à appliquer" }
      }
    },
    "flatverse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lua_scripts": { "type": "array", "items": { "type": "string" } },
        "wrist_hud": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widget": { "type": "string" },
            "hand": { "enum": ["left", "right"] },
            "scale": { "type": "number", "minimum": 0.05, "maximum": 2 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "description": "URL ou mention Discord d'origine" },
        "license": { "const": "CC-BY-4.0" },
        "generated_by_ai": { "type": "boolean" },
        "human_validated": { "type": "boolean" }
      }
    }
  }
}
